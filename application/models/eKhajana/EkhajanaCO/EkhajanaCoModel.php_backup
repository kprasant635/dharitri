    public function RevertToMouzadarFromCo($posted_data)
    {
        $this->db->trans_begin();
        //updating ekhajana basic table status
        $update_data = array(
            'pending_with_officer'  => 'MOUZADAR',
            'status'                => EKAHAJANA_CO_REVERT_TO_MOUZADAR_STATUS,
            'co_remark'             => $posted_data['revert_reason'],
            'user_code'             => $this->session->all_userdata()['user_code'],
            'modified_at'           => date('Y-m-d h:i:s'),
        ); 
        $this->db->where('ld_application_no', $posted_data['ld_application_no']);
        $this->db->update('ekhajana_basic', $update_data);
        if($this->db->affected_rows() != 1){ 
            $this->db->trans_rollback();
            log_message("error", "#EKRTOMFCO021, Error in update, table 'ekhajana_basic'  with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKRTOMFCO021'];
        }
        //ekhajana basic proceeding details insert
        $proceeding_details_data = array(
            'ld_application_no' => $posted_data['ld_application_no'],
            'application_no'    => $posted_data['application_no'],
            'remark'            => $posted_data['revert_reason'],            
            'user_code'         => $this->session->all_userdata()['user_code'],
            "created_at"        => date('Y-m-d h:i:s'),
            "case_no"           => $posted_data['case_no'],
            'status'            => EKAHAJANA_CO_REVERT_TO_MOUZADAR_STATUS, 
        ); 
        $tstatus2 = $this->db->insert('ekhajana_basic_proceedings', $proceeding_details_data); 
        if ($tstatus2!= 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKRTOMFCO022, Error in insert on ekhajana_basic_proceedings table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKRTOMFCO022'];
        }
        
        //*********************************************************/
        //final transaction status check 
        if($this->db->trans_status()==FALSE){
            $this->db->trans_rollback();
            log_message("error", "#EKRTOMFCO023, Transaction Status Error In Saving data in dharitree with query- ". json_encode($this->db->last_query()));
            return ['result' => false, 'msg' => 'Some error occured, Error-Code : #EKRTOMFCO023'];
        }else{
            $curl = curl_init();
            curl_setopt_array($curl, array(
                CURLOPT_URL => EKHAJANA_CO_REVERT_TO_MOUZADAR_API,
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_ENCODING => '',
                CURLOPT_MAXREDIRS => 10,
                CURLOPT_TIMEOUT => 0,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                CURLOPT_CUSTOMREQUEST => 'POST',
                CURLOPT_SSL_VERIFYPEER => FALSE,
                CURLOPT_SSL_VERIFYHOST => 0,
                CURLOPT_POSTFIELDS => array(
                    'ld_application_no' => $posted_data['ld_application_no'],
                    'application_no'    => $posted_data['application_no'],
                    'dharitree_case_no' => $posted_data['case_no'],
                    'user_code'         => $this->session->all_userdata()['user_code'],                    
                    'date_of_action'    => date("Y-m-d"),
                    'remark'            => $posted_data['revert_reason'],
                    'patta_no'          => $posted_data['patta_no'],  
                ),
            ));
            $response = curl_exec($curl);
            $httpcode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
            curl_close($curl);
            if($httpcode == 200){
                $response_obj = json_decode($response);
                if($response_obj->result == "Y"){
                    $this->db->trans_commit();
                    return ['result' => 'SUCCESS', 'msg' => 'Ekhajana Case Details Reverted To Mouzadar Successfully!'];                 
                }else{
                    $this->db->trans_rollback();
                    log_message("error", "#EKFTADCCRLL085404, Curl Error(Y) In Api ".EKHAJANA_CO_REVERT_TO_MOUZADAR_API);
                    return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADCCRLL085404'];
                } 
            }else{
                $this->db->trans_rollback();
                log_message("error", "#EKFTADCCRLL085405, Curl Error(200) In Api ".EKHAJANA_CO_REVERT_TO_MOUZADAR_API);
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADCCRLL085405'];
            }
        }
    }

