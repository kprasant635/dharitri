    public function getNewMb2Patta($dist_code,$subdiv_code,$cir_code)
    {
        $query = "SELECT 
                cb.dist_code, cb.subdiv_code, cb.cir_code, cb.mouza_pargona_code,
                cb.lot_no, cb.vill_townprt_code, cb.patta_type_code, cb.patta_no,
                SUM(cb.dag_revenue) AS total_dag_revenue,
                SUM(cb.dag_local_tax) AS total_dag_local_tax,
                SUM(cb.dag_area_b*100+ cb.dag_area_k*20 + cb.dag_area_lc) AS total_lessa
            FROM chitha_basic cb
            LEFT JOIN current_doul_demand cdd
            ON cb.dist_code = cdd.dist_code
            AND cb.subdiv_code = cdd.subdiv_code
            AND cb.cir_code = cdd.cir_code
            AND cb.mouza_pargona_code = cdd.mouza_pargona_code
            AND cb.lot_no = cdd.lot_no
            AND cb.vill_townprt_code = cdd.vill_townprt_code
            AND cb.patta_type_code = cdd.patta_type_code
            AND cb.patta_no = cdd.patta_no
            WHERE cdd.dist_code IS NULL
            AND cb.possession_from IS NOT NULL
            AND cb.patta_type_code IN (SELECT type_code FROM patta_code WHERE jamabandi = 'y')
            GROUP BY cb.dist_code, cb.subdiv_code, cb.cir_code, cb.mouza_pargona_code,
                    cb.lot_no, cb.vill_townprt_code, cb.patta_type_code, cb.patta_no";
        $mb2_pattas_not_in_doul = $this->db->query($query)->result();
        if (empty($mb2_pattas_not_in_doul)) {
            log_message("error", "No new pattas found for migration.");
            return "NO-NEW_PATTAS_FOUND";
        }else{
            return $mb2_pattas_not_in_doul;
        }
        

    }

    //getting village uuid
    function getVillageUUID($dist_code,$subdiv_code,$cir_code,$mouza_code,$lot_no,$vill_code){    
        $sql = "select uuid from location where dist_code = ? and subdiv_code = ? and cir_code = ? 
                and mouza_pargona_code = ? and lot_no = ? and vill_townprt_code  = ?";
        $query = $this->db->query($sql,array($dist_code,$subdiv_code,$cir_code,$mouza_code,$lot_no,$vill_code, '0000'));        
        $result = $query->result(); 

        if(count($result) != 0 ){
            return $result[0]->uuid;
        }else{
            return "";
        }
    }

    public function insertMB2PattaIntoDoul($all_data)
    {
        //current_doul_Demand insert with status 'N' (newly added)
        foreach($all_data as $data){

            $uuid = $this->getVillageUUID($data['dist_code'], $data['subdiv_code'], $data['cir_code'], $data['mouza_pargona_code'], $data['lot_no'], $data['vill_townprt_code']);
            // Convert area
            $area = $this->Total_Bigha_Katha_Lessa($data['total_lessa']);
            // var_dump($data['total_lessa']);
            // exit;
            $bigha = $area[0];
            $katha = $area[1];
            $lessa = $area[2];
            $gonda = $area[3];

            //checking if the patta already exists
            $checkDataExistence = $this->db->query("select * from current_doul_demand where dist_code=? and subdiv_code=? and cir_code=?
                and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=? and patta_no=?",array($data['dist_code'],$data['subdiv_code'],
                $data['cir_code'],$data['mouza_pargona_code'],$data['lot_no'],$data['vill_townprt_code'],$data['patta_type_code'],$data['patta_no']));
            if($checkDataExistence->num_rows() > 0)
            {
                $this->db->trans_rollback();
                log_message("error", "#ERRICDD0784, Error in insert on current_doul_demand table with query- ". json_encode($this->db->last_query()));
                return ['result' => 'SERVER-ERROR', 'msg' => '#ERRICDD0784 Patta Details Already exists in doul, Please check again...!!!'];
            }

            $current_doul_demand = array(
                "dist_code"         => $data['dist_code'],
                "subdiv_code"       => $data['subdiv_code'],
                "cir_code"          => $data['cir_code'], 
                "mouza_pargona_code"=> $data['mouza_pargona_code'], 
                "lot_no"            => $data['lot_no'], 
                "vill_townprt_code" => $data['vill_townprt_code'], 
                "uuid"              => $uuid, 
                "patta_type_code"   => $data['patta_type_code'], 
                "patta_no"          => $data['patta_no'],
                "dag_area_b"        => $bigha,
                "dag_area_k"        => $katha,
                "dag_area_lc"       => $lessa,
                "dag_area_g "       => null,
                "dag_area_kr"       => null,
                "dag_revenue"       => $data['dag_revenue'],
                "dag_local_tax"     => $data['dag_local_tax'],
                "date_of_creation"  => date('Y-m-d h:i:s'),
                "year_no"           => doul_year_no,
                "port_by_user"      => $this->session->all_userdata()['user_code'],
                "port_ip"           => $this->session->all_userdata()['ip_address'], 
                "status"            => EKHAJANA_MB2_PATTA_STATUS_IN_DOUL //'N'
            ); 
            $tstatus2 = $this->db->insert('current_doul_demand', $current_doul_demand); 
            if ($tstatus2!= 1)
            {
                $this->db->trans_rollback();
                log_message("error", "#ERRICDD001, Error in insert on current_doul_demand table with query- ". json_encode($this->db->last_query()));
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #ERRICDD001'];
            }
            //checking if the patta already exists
            $checkDataExistence2 = $this->db->query("select * from current_doul_demand_transactions where dist_code=? and subdiv_code=? and cir_code=?
                and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=? and patta_no=?",array($data['dist_code'],$data['subdiv_code'],
                $data['cir_code'],$data['mouza_pargona_code'],$data['lot_no'],$data['vill_townprt_code'],$data['patta_type_code'],$data['patta_no']));
            if($checkDataExistence2->num_rows() > 0)
            {
                $this->db->trans_rollback();
                log_message("error", "#ERRICDD0785, Error in insert on current_doul_demand_transactions table with query- ". json_encode($this->db->last_query()));
                return ['result' => 'SERVER-ERROR', 'msg' => '#ERRICDD0785 Patta Details Already exists in doul, Please check again...!!!'];
            }
            //insert the json into the transaction table
            $current_doul_transactions = array(
                "dist_code"         => $data['dist_code'],
                "subdiv_code"       => $data['subdiv_code'],
                "cir_code"          => $data['cir_code'], 
                "mouza_pargona_code"=> $data['mouza_pargona_code'], 
                "lot_no"            => $data['lot_no'], 
                "vill_townprt_code" => $data['vill_townprt_code'], 
                "uuid"              => $uuid, 
                "patta_type_code"   => $data['patta_type_code'], 
                "patta_no"          => $data['patta_no'],
                "dag_area_b"        => $bigha,
                "dag_area_k"        => $katha,
                "dag_area_lc"       => $lessa,
                "dag_area_g "       => null,
                "dag_area_kr"       => null,
                "dag_revenue"       => $data['dag_revenue'],
                "dag_local_tax"     => $data['dag_local_tax'],
                "date_of_creation"  => date('Y-m-d h:i:s'),
                "year_no"           => doul_year_no,
                "port_by_user"      => $this->session->all_userdata()['user_code'],
                "port_ip"           => $this->session->all_userdata()['ip_address'], 
                "status"            => EKHAJANA_MB2_PATTA_STATUS_IN_DOUL //'N'
            ); 
            $tstatus2 = $this->db->insert('current_doul_demand_transactions', $current_doul_transactions); 
            if ($tstatus2!= 1)
            {
                $this->db->trans_rollback();
                log_message("error", "#ERRICDD002, Error in insert on current_doul_demand_transactions table with query- ". json_encode($this->db->last_query()));
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #ERRICDD002'];
            }
        }
        //final transaction status check 
        if($this->db->trans_status()==FALSE){
            $this->db->trans_rollback();
            log_message("error", "#ERRICDD002, Transaction Status Error In Saving current_doul_demand with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #ERRICDD002'];
        }else{
            $this->db->trans_commit();
            return ['result' => 'SUCCESS', 'msg' => 'All New Pattas Added to Current Doul Successfully'];
        }
         
    }

    function Total_Bigha_Katha_Lessa($total_lessa)
    {
        $mm = 0;
        if($total_lessa < 0)
        {
            $mm = 1;
            $total_lessa = abs($total_lessa);
        }
        $bigha = $total_lessa / 100;
        $rem_lessa = fmod($total_lessa, 100);
        $katha = $rem_lessa / 20;
        $r_lessa = fmod($rem_lessa, 20);
        $mesaure = array();
        $mesaure[].=($mm==1) ? -floor($bigha): floor($bigha);
        $mesaure[].=($mm==1) ? -floor($katha): floor($katha);
        $mesaure[].=($mm==1) ? -($r_lessa) : $r_lessa;
        $mesaure[].=0;
        return $mesaure;
    }

    public function getAllVillages($dist_code,$subdiv_code,$cir_code)
    {
        $villages = $this->db->query("select *  from   location where dist_code =?  and  subdiv_code=? and cir_code=? and mouza_pargona_code!='00'  and lot_no!='00' and vill_townprt_code!='00000' order by vill_townprt_code",array($dist_code,$subdiv_code,$cir_code));
        return $villages->result();
    }

    //getting patta types 
    public function getAllPattas() {
        $patta = $this->db->query("Select type_code,patta_type,pattatype_eng from patta_code order by type_code asc");
        return $patta->result();
    }
    
    
}

