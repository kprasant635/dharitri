    //getting current revenue and local tax
    public function getCurrentDoulDetails($ArrearData){
        $query = $this->db->select("*")
                            ->where('dist_code', $ArrearData->dist_code)
                            ->where('subdiv_code', $ArrearData->subdiv_code)
                            ->where('cir_code', $ArrearData->cir_code)
                            ->where('mouza_pargona_code', $ArrearData->mouza_pargona_code)
                            ->where('lot_no', $ArrearData->lot_no)
                            ->where('vill_townprt_code', $ArrearData->vill_townprt_code)
                            ->where('patta_type_code', $ArrearData->patta_type_code)
                            ->where('patta_no', $ArrearData->patta_no)
                            ->from('current_doul_demand')
                            ->get(); 
        //echo $this->db->last_query();
        if($query->num_rows() != 0){
            $row = $query->row();
            if(($row->dag_revenue=='' || $row->dag_revenue==null) || ($row->dag_local_tax=='' || $row->dag_local_tax==null)){
                return ['flag' => false, 'result' => 'Revenue Or Local Tax Not Found in Doul For The Patta : '.$land_details->patta_no. ", Please verify the patta no in current doul.!" ];
            }else{
                return ['flag' => true, 'result' => $row];
            }
            
        }else{
            return ['flag' => false, 'result' => 'Doul Entry Not Found For The Patta : '.$land_details->patta_no. ", Please verify the patta no in current doul.!" ];
        }  
    }


    //checking jama wasil exists or not against dharitree case number
    public function CheckJamaWasilWithUnpaidStatus($caseDetails){
        $query = $this->db->select('*')
                        ->where('dist_code', $caseDetails['dist_code'])
                        ->where('subdiv_code', $caseDetails['subdiv_code'])
                        ->where('cir_code', $caseDetails['cir_code'])
                        ->where('mouza_pargona_code', $caseDetails['mouza_pargona_code'])
                        ->where('lot_no', $caseDetails['lot_no'])
                        ->where('vill_townprt_code', $caseDetails['vill_townprt_code'])
                        //->where('village_uuid', $caseDetails['village_uuid'])
                        ->where('patta_type_code', $caseDetails['patta_type_code'])
                        ->where('patta_no', $caseDetails['patta_no'])
                        ->where('pay_status', 'UNPAID')
                        ->from('jama_wasil')
                        ->get(); 
            if($query->num_rows() != 0 ){
                return $query->row();
            }else{
                return false;
            }
    }


    public function COdisposeCaseMouzadariSystemWithJwUpdate($posted_data,$ArrearData,$ekBasicDetails,
    $jama_wasil_data,$jama_wasil_payee_list_data,$jama_wasil_backup_table_data,$getJamaWasilUnpaidData){
        error_reporting(0);
        $this->db->trans_begin();
        //**************************************************//
        //update data in jama_wasil 
        $tstatus1 = $this->db->where('id',$getJamaWasilUnpaidData->id)
                            ->where('dist_code',$getJamaWasilUnpaidData->dist_code)
                            ->where('subdiv_code',$getJamaWasilUnpaidData->subdiv_code)
                            ->where('cir_code',$getJamaWasilUnpaidData->cir_code)
                            ->where('mouza_pargona_code',$getJamaWasilUnpaidData->mouza_pargona_code)
                            ->where('lot_no',$getJamaWasilUnpaidData->lot_no)
                            ->where('vill_townprt_code',$getJamaWasilUnpaidData->vill_townprt_code)
                            ->where('patta_type_code',$getJamaWasilUnpaidData->patta_type_code)
                            ->where('patta_no',$getJamaWasilUnpaidData->patta_no)
                            ->update('jama_wasil', $jama_wasil_data);    
        if($this->db->affected_rows() != 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKIAU001, Error in update on jama_wasil table with  query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU001'];
        }        
        //**************************************************//
        $jama_wasil_inserted_id = $getJamaWasilUnpaidData->id; 
        //**************************************************//
        //insert data in jama_wasil_transaction 
        $jama_wasil_data['jama_wasil_id'] = $jama_wasil_inserted_id;
        $jama_wasil_data['created_at'] = date('Y-m-d h:i:s');
        $tstatus2 = $this->db->insert('jama_wasil_transaction', $jama_wasil_data); 
        if ($tstatus2 != 1 )
        {
            $this->db->trans_rollback();
            log_message("error", "#EKIAU002, Error in insert on jama_wasil_transaction table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU002'];
        }
        //**************************************************//
        $jama_wasil_transaction_inserted_id = $this->db->insert_id();
        
        //**************************************************//
        //insert data in jama_wasil_backup
        $tstatus4 = $this->db->insert('jama_wasil_backup', $jama_wasil_backup_table_data); 
        if ($tstatus4 != 1 )
        {
            $this->db->trans_rollback();
            log_message("error", "#EKIAU004, Error in insert on jama_wasil_backup table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU004'];
        }
        //**************************************************//
        //ekhajana basic update 
        $update_data = array(
            'status' => EKHAJANA_STATUS_COMPLETED,
            'pending_with_officer' => '--',
            'co_remark' => $posted_data['co_report'],
            'user_code' => $this->session->all_userdata()['user_code'],
            'modified_at' => date('Y-m-d h:i:s'),
            'co_pattadar_identification_flag' => $posted_data['pattadar_identified']
        ); 
        $this->db->where('case_no', $ekBasicDetails->case_no);
        $this->db->update('ekhajana_basic', $update_data);
        if($this->db->affected_rows() != 1){ 
            $this->db->trans_rollback();
            log_message("error", "#EKIAU005, Error in update , table 'ekhajana_basic' with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU005'];
        }
        //ekhajana mouzadar arrear details update 
        // $update_data_arrear = array(
        //     'ek_basic_id' => $ekBasicDetails->id
        // ); 
        // $this->db->where('case_no', $ekBasicDetails->case_no);
        // $this->db->update('ekhajana_mouzadar_arrear_details', $update_data_arrear);
        // if($this->db->affected_rows() != 1){ 
        //     $this->db->trans_rollback();
        //     log_message("error", "#EKIAU0055, Error in update table 'ekhajana_mouzadar_arrear_details' with query- ". json_encode($this->db->last_query()));
        //     return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU0055'];
        // }
        //ekhajana basic proceeding details insert
        $proceeding_details_data = array(
            'ld_application_no' => $ekBasicDetails->ld_application_no,
            'application_no' => $ekBasicDetails->application_no,
            'remark' => "CO-CASE-DISPOSED",            
            'user_code' => $this->session->all_userdata()['user_code'],
            "created_at" => date('Y-m-d h:i:s'),
            "case_no" => $ekBasicDetails->case_no,
            'status' => EKHAJANA_STATUS_COMPLETED
        ); 
        $tstatus2 = $this->db->insert('ekhajana_basic_proceedings', $proceeding_details_data); 
        //return $this->db->last_query();
        if ($tstatus2!= 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKIAU009, Error in insert on ekhajana_basic_proceedings table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU009'];
        }
        //**************************************************//
        //transaction final check
        if($this->db->trans_status()==FALSE){
            $this->db->trans_rollback();
            log_message("error", "#EKIAU006, Transaction Error In Ekhajana Co Dispose");
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAU006'];
        }else{
            //basundhara ekhajana payment update
            //basundhara ekhajana land details update
            $curl = curl_init();
            curl_setopt_array($curl, array(
                CURLOPT_URL => EKHAJANA_DISPOSE_UPDATE_API,
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_ENCODING => '',
                CURLOPT_MAXREDIRS => 10,
                CURLOPT_TIMEOUT => 0,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                CURLOPT_CUSTOMREQUEST => 'POST',
                CURLOPT_SSL_VERIFYPEER => FALSE,
                CURLOPT_SSL_VERIFYHOST => 0,
                CURLOPT_POSTFIELDS => array(
                        'ld_application_no' => $ekBasicDetails->ld_application_no,
                        'application_no' => $ekBasicDetails->application_no,
                        'dharitree_case_no' => $ekBasicDetails->case_no,
                        'due_payment' => $jama_wasil_data['due_payment'],
                        'user_code' => $this->session->all_userdata()['user_code'],                    
                        'date_of_action' => date("Y-m-d"),
                        "patta_no" => $ekBasicDetails->patta_no,
                        'remark' => "CO CASE DISPOSED",
                    ),
            ));
            $response = curl_exec($curl);
            $httpcode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
            curl_close($curl);
            if($httpcode == 200){
                //return "curl successfull";
                $response_obj = json_decode($response);
                if($response_obj->result == "Y"){
                    $this->db->trans_commit();
                    return ['result' => 'SUCCESS', 'msg' => 'Case Disposed Sucessfully..!'];                 
                }else{
                    $this->db->trans_rollback();
                    log_message("error", "#EKIAUCRL007, Curl Error(Y) In Api ".EKHAJANA_DISPOSE_UPDATE_API);
                    return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAUCRL007'];
                } 
            }else{
                $this->db->trans_rollback();
                log_message("error", "#EKIAUCRL008, Curl Error(200) In Api ".EKHAJANA_DISPOSE_UPDATE_API);
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKIAUCRL008'];
            }
        }
    }

    public function getDPFlaggingStatus_old($dist_code,$subdiv_code,$cir_code,$mouza_pargona_code,$lot_no, $vill_townprt_code,$patta_type_code,$patta_no){
        
        $query = $this->db->select('dp_flag_yn')
                            ->where('dist_code', $dist_code)
                            ->where('subdiv_code', $subdiv_code)
                            ->where('cir_code', $cir_code)
                            ->where('mouza_pargona_code', $mouza_pargona_code)
                            ->where('lot_no', $lot_no)
                            ->where('vill_townprt_code', $vill_townprt_code)
                            ->where('patta_type_code', $patta_type_code)
                            ->where('patta_no', $patta_no)
                            ->from('chitha_basic')
                            ->get();            
        if($query->num_rows() == 0){
            //no chitha basic rows found
            return false;
        }
        $chithaRes = $query->result();
        foreach($chithaRes as $row){
            if($row->dp_flag_yn == 'Y'){
                //if atleast one dag found to be dp in mouzadari area then payment is not accepted
                return "DP";
            }
        }
        return "NON-DP";   
    }


    public function getDPFlaggingStatus($dist_code,$subdiv_code,$cir_code,$mouza_pargona_code,$lot_no, $vill_townprt_code,$patta_type_code,$patta_no){
        $chitha_query = $this->db->query("select * from chitha_basic where dist_code=? and subdiv_code=?
        and cir_code=? and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=?
        and patta_no=? and dp_flag_yn=?", array($dist_code,$subdiv_code,$cir_code,$mouza_pargona_code,$lot_no,
        $vill_townprt_code,$patta_type_code,$patta_no,'Y'));
        if($chitha_query->num_rows() == 0){
            return "NON-DP";
        }else{
            $jama_query = $this->db->query("select * from jama_dag where dist_code=? and subdiv_code=?
            and cir_code=? and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=?
            and patta_no=? and dp_flag_yn=?", array($dist_code,$subdiv_code,
            $cir_code,$mouza_pargona_code,$lot_no,
            $vill_townprt_code,$patta_type_code,$patta_no,'Y'));
            if($jama_query->num_rows() == 0){
                return "DP";
            }else{
                return "NON-DP";
            }
        }
    }

    public function getJamaWasil($caseDetails){
        $query = $this->db->select('*')
                        ->where('dist_code', $caseDetails['dist_code'])
                        ->where('subdiv_code', $caseDetails['subdiv_code'])
                        ->where('cir_code', $caseDetails['cir_code'])
                        ->where('mouza_pargona_code', $caseDetails['mouza_pargona_code'])
                        ->where('lot_no', $caseDetails['lot_no'])
                        ->where('vill_townprt_code', $caseDetails['vill_townprt_code'])
                        //->where('village_uuid', $caseDetails['village_uuid'])
                        ->where('patta_type_code', $caseDetails['patta_type_code'])
                        ->where('patta_no', $caseDetails['patta_no'])
                        //->where('pay_status', 'PAID')
                        ->from('jama_wasil')
                        ->get(); 
        if($query->num_rows() == 0){
            return "jama_wasil_not_exists";
        }else{
            $row =  $query->row();
            if($row->pay_status == 'PAID'){
                return "paid_in_jama_wasil";
            }elseif($row->pay_status == 'UNPAID'){
                return "unpaid_in_jama_wasil";
            }else{
                return false;
            }
        }
    }

