    public function checkDoulStatusBeforeForward($dist_code,$subdiv_code,$cir_code,$mouza_pargona_code,$lot_no,$vill_townprt_code,$patta_type_code,$patta_no){
        $query = $this->db->select("*")
                ->where('dist_code', $dist_code)
                ->where('subdiv_code', $subdiv_code)
                ->where('cir_code', $cir_code)
                ->where('mouza_pargona_code', $mouza_pargona_code)
                ->where('lot_no', $lot_no)
                ->where('vill_townprt_code', $vill_townprt_code)
                ->where('patta_type_code', $patta_type_code)
                ->where('patta_no', $patta_no)
                ->from('current_doul_demand')
                ->get(); 
        if($query->num_rows() != 0){
            $row = $query->row();
            if(($row->dag_revenue=='' || $row->dag_revenue==null) || ($row->dag_local_tax=='' || $row->dag_local_tax==null)){
                return ['result' => false, 'msg' => 'Revenue Or Local Tax Not Found in Doul For The Patta : '.$patta_no. ", Please verify the patta no in current doul.!" ];
            }else{
                return ['result' => true, 'msg' => ''];
            }
            
        }else{
            return ['result' => false, 'msg' => 'Doul Entry Not Found For The Patta : '.$patta_no. ", Please verify the patta no in current doul.!" ];
        }        
    }

