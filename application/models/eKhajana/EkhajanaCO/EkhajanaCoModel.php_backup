    //getting the count of revert cases 
    public function revertedForCoCount($dist_code,$subdiv_code,$cir_code){
        $query = $this->db->select('count(*)')
                    ->where('dist_code', $dist_code)
                    ->where('subdiv_code', $subdiv_code)
                    ->where('cir_code', $cir_code)
                    ->where('status', EKHAJANA_AST_MOU_REVERT)
                    ->from('ekhajana_basic')
                    ->get(); 
        if($query->num_rows() != 0 ){
            return $query->row()->count;
        }else{
            return 0;
        }
    }

    //getting the reverted list for co 
    public function revertedListForCo($dist_code,$subdiv_code,$cir_code){
        $query = $this->db->select('*')
                    ->where('dist_code', $dist_code)
                    ->where('subdiv_code', $subdiv_code)
                    ->where('cir_code', $cir_code)
                    ->where('status', EKHAJANA_AST_MOU_REVERT)
                    ->from('ekhajana_basic')
                    ->get(); 
        return $query->result();
    }

    //getting jama wasil details 
    public function getJamaWasilDetails($dist_code,$subdiv_code,$cir_code, $mouza_pargona_code, $lot_no, $vill_townprt_code, $patta_type_code, $patta_no){
        $query = $this->db->select('*')
                          ->where('dist_code', $dist_code)
                          ->where('subdiv_code', $subdiv_code)
                          ->where('cir_code', $cir_code)
                          ->where('mouza_pargona_code', $mouza_pargona_code)
                          ->where('lot_no', $lot_no)
                          ->where('vill_townprt_code', $vill_townprt_code)
                          ->where('patta_type_code', $patta_type_code)
                          ->where('patta_no', $patta_no)
                          ->from('jama_wasil')
                          ->get();

        if($query->num_rows() == 1){
            $jama_wasil_details = $query->row();
            if($jama_wasil_details->status == JAMA_WASIL_STATUS_ONLINE){
                return "KHAJANA FOR PATTA ".$patta_no." IS PAID, YOU CAN FORWARD THIS CASE TO ASSISTNAT/MOUZADAR TO DISPOSE. AFTER DISPOSED, THE PATTADAR CAN DOWNLOAD THE KHAJANA RECEIPT";
            }else{
                return "KHAJANA FOR PATTA ".$patta_no." IS UPDATED, BUT PAYMENT IS NOT RECIEVED FOR THIS PATTA";
            }
        }else{
            return "KHAJANA FOR PATTA ".$patta_no." IS NOT UPDATED YET";
        }
    }

    //function to fetch the data where jamawasil status is offline
    public function JamaWasilOfflineData($dist_code,$subdiv_code,$cir_code){
        $query = $this->db->select('(select loc_name from location where
         subdiv_code=j.subdiv_code and cir_code=j.cir_code and mouza_pargona_code=j.mouza_pargona_code 
         and lot_no=j.lot_no and vill_townprt_code=j.vill_townprt_code) as village_name,*')
                          ->where('dist_code', $dist_code)
                          ->where('subdiv_code', $subdiv_code)
                          ->where('cir_code', $cir_code)  
                          ->where('status', JAMA_WASIL_STATUS_OFFLINE)
                          ->from('jama_wasil j')
                          ->get();
            return $query->result();
    }
   
    //getting the details of dharitree from id
    public function getEkBasicDetailsFromId($ek_basic_id){        
        $query = $this->db->select('*')
                    ->where('id', $ek_basic_id)
                    ->from('ekhajana_basic')
                    ->get(); 
        if($query->num_rows() != 0 ){
            return $query->row();
        }else{
            return false;
        }
    }

    //getting current revenue and local tax
    public function getCurrentRevenueAndLocalTaxFromDoul($village_uuid,$patta_type_code,$patta_no){
        $query = $this->db->select("*")
                ->where('uuid', $village_uuid)
                ->where('patta_type_code', $patta_type_code)
                ->where('patta_no', $patta_no)
                ->from('current_doul_demand')
                ->get(); 
        if($query->num_rows() != 0){
            return ['flag' => true, 'result' => $query->row()];
        }else{
            return ['flag' => false, 'result' => []];
        }        
    }

    //updating and inserting in jama wasil and updating status in basundhara
    public function arrearReUpdate($jama_wasil_update_data,
    $jama_wasil_backup_table_update_data,$jama_wasil_details){
        error_reporting(0);
        $this->db->trans_begin();
        //**************************************************//
        //update data in jama_wasil 
        $this->db->where('dist_code',$jama_wasil_details->dist_code)
                    ->where('subdiv_code',$jama_wasil_details->subdiv_code)
                    ->where('cir_code',$jama_wasil_details->cir_code)
                    ->where('mouza_pargona_code',$jama_wasil_details->mouza_pargona_code) 
                    ->where('lot_no',$jama_wasil_details->lot_no)
                    ->where('vill_townprt_code',$jama_wasil_details->vill_townprt_code) 
                    ->where('village_uuid',$jama_wasil_details->village_uuid) 
                    ->where('patta_type_code',$jama_wasil_details->patta_type_code)
                    ->where('patta_no',$jama_wasil_details->patta_no)
                    ->where('case_no',$jama_wasil_details->case_no)
                    ->update('jama_wasil', $jama_wasil_update_data); 
        if ($this->db->affected_rows() != 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKHRED001, Error in update on jama_wasil table with  query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKHRED001'];
        }
        //**************************************************//
        //update data in jama_wasil_transaction 
        $this->db->where('dist_code',$jama_wasil_details->dist_code)
                    ->where('subdiv_code',$jama_wasil_details->subdiv_code)
                    ->where('cir_code',$jama_wasil_details->cir_code)
                    ->where('mouza_pargona_code',$jama_wasil_details->mouza_pargona_code) 
                    ->where('lot_no',$jama_wasil_details->lot_no)
                    ->where('vill_townprt_code',$jama_wasil_details->vill_townprt_code) 
                    ->where('village_uuid',$jama_wasil_details->village_uuid) 
                    ->where('patta_type_code',$jama_wasil_details->patta_type_code)
                    ->where('patta_no',$jama_wasil_details->patta_no)
                    ->where('case_no',$jama_wasil_details->case_no)
                    ->update('jama_wasil_transaction', $jama_wasil_update_data); 
        if ($this->db->affected_rows() <= 0)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKHRED002, Error in update on jama_wasil_transaction table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKHRED002'];
        }
        //**************************************************//
        //insert data in jama_wasil_backup
        $tstatus4 = $this->db->insert('jama_wasil_backup', $jama_wasil_backup_table_update_data); 
        if ($tstatus4 != 1 )
        {
            $this->db->trans_rollback();
            log_message("error", "#EKHRED003, Error in insert on jama_wasil_backup table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKHRED003'];
        }
        //**************************************************//
        
        //ekhajana basic proceeding details insert
        $proceeding_details_data = array(
            'ld_application_no' => $jama_wasil_details->ld_application_no,
            'application_no'    => $jama_wasil_details->application_no,
            'remark'            => "CO-ARREAR-RE-UPDATED",            
            'user_code'         => $this->session->all_userdata()['user_code'],
            "created_at"        => date('Y-m-d h:i:s'),
            "case_no"           => $jama_wasil_details->case_no,
            'status'            => EKHAJANA_STATUS_COMPLETED
        ); 
        $tstatus2 = $this->db->insert('ekhajana_basic_proceedings', $proceeding_details_data); 
        if ($tstatus2!= 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKHRED005, Error in insert on ekhajana_basic_proceedings table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKHRED005'];
        }
        //**************************************************//
        //transaction final check
        if($this->db->trans_status()==FALSE){
            $this->db->trans_rollback();
            log_message("error", "#EKHRED006, Transaction Status Error In Mouzadar Arrear Update Details with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKHRED006'];
        }else{
            //basundhara ekhajana payment update
            //basundhara ekhajana land details update
            $curl = curl_init();
            curl_setopt_array($curl, array(
                CURLOPT_URL => EKHAJANA_PAYMENT_RE_UPDATE_BY_CO_API,
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_ENCODING => '',
                CURLOPT_MAXREDIRS => 10,
                CURLOPT_TIMEOUT => 0,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                CURLOPT_CUSTOMREQUEST => 'POST',
                CURLOPT_SSL_VERIFYPEER => FALSE,
                CURLOPT_SSL_VERIFYHOST => 0,
                CURLOPT_POSTFIELDS => array(
                        'ld_application_no' => $jama_wasil_details->ld_application_no,
                        'application_no' => $jama_wasil_details->application_no,
                        'dharitree_case_no' => $jama_wasil_details->case_no,
                        'due_payment' => $jama_wasil_update_data['due_payment'],
                        'user_code' => $this->session->all_userdata()['user_code'],                  
                        'date_of_action' => date("Y-m-d"),
                        "patta_no" => $jama_wasil_details->patta_no,
                        'remark' => "CO ARREAR RE-UPDATED",
                    ),
            ));
            $response = curl_exec($curl);
            $httpcode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
            curl_close($curl);
            if($httpcode == 200){
                //return "curl successfull";
                $response_obj = json_decode($response);
                if($response_obj->result == "Y"){
                    $this->db->trans_commit();
                    return ['result' => 'SUCCESS', 'msg' => 'Arrear Re-Updated Sucessfully..!'];                 
                }else{
                    $this->db->trans_rollback();
                    log_message("error", "#EKREAUCRL007, Curl Error(Y) In Api ".EKHAJANA_PAYMENT_RE_UPDATE_BY_CO_API);
                    return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKREAUCRL007'];
                } 
            }else{
                $this->db->trans_rollback();
                log_message("error", "#EKREAUCRL008, Curl Error(200) In Api ".EKHAJANA_PAYMENT_RE_UPDATE_BY_CO_API);
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKREAUCRL008'];
            }
        } 
    }

    //function to chck the payment reponse from rtps
    public function checkPaymentQuerybeforeUpdate($case_no){
        $curl = curl_init();
        curl_setopt_array($curl, array(
            CURLOPT_URL => EKHAJANA_CHECK_PAYMENT_STATUS_BEFORE_REUPDATE,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_ENCODING => '',
            CURLOPT_MAXREDIRS => 10,
            CURLOPT_TIMEOUT => 0,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
            CURLOPT_CUSTOMREQUEST => 'POST',
            CURLOPT_POSTFIELDS => array(
                    'application_no' => $case_no,
                ),
        ));
        $response = curl_exec($curl);
        $httpcode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
        curl_close($curl);
        if($httpcode == 200){
            $response_obj = json_decode($response);
            if($response_obj->result == "Y"){
                return 'Y';                 
            }else{
                log_message("error", "#EKREAUCRL011, Curl Error(Y) In Api ".EKHAJANA_CHECK_PAYMENT_STATUS_BEFORE_REUPDATE);
                return 'N';
            } 
        }else{
            log_message("error", "#EKREAUCRL012, Curl Error(200) In Api ".EKHAJANA_CHECK_PAYMENT_STATUS_BEFORE_REUPDATE);
            return 'N';
        }
    } 

