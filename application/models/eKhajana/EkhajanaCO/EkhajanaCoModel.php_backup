    public function updateDataInDharitreeEkhajana($application_no)
    {
        $patta_detail = $this->db->query("select * from ekhajana_basic where application_no =?",array($application_no));
        if($patta_detail->num_rows() == 0){
            return ['result' => "SERVER-ERROR" , 'msg' => "#ERR19072024001 No case Found Against the Application No"];
            log_message("error" ,"#ERR19072024001 No Cases Found with application no".$application_no);
        }
        $patta_details = $patta_detail->row();
        $dist_code          = $patta_details->dist_code;
        $subdiv_code        = $patta_details->subdiv_code;
        $cir_code           = $patta_details->cir_code;
        $mouza_pargona_code = $patta_details->mouza_pargona_code;
        $lot_no             = $patta_details->lot_no;
        $vill_townprt_code  = $patta_details->vill_townprt_code;
        $patta_type_code    = $patta_details->patta_type_code;
        $patta_no           = $patta_details->patta_no;

        $jama_wasil= $this->db->query("select * from jama_wasil where dist_code=? and subdiv_code=? and cir_code=? and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=? and patta_no=?",array($dist_code,$subdiv_code,$cir_code,$mouza_pargona_code,$lot_no,$vill_townprt_code,$patta_type_code,$patta_no));
        if($jama_wasil->num_rows() == 0){
            return ['result' => "SERVER-ERROR" , 'msg' => "#ERR19072024002 No case Found Against the Application No: $application_no"];
            log_message("error" ,"#ERR19072024002 No Cases Found in jama wasil with application no".$application_no);
        }
        $jama_wasil_row = $jama_wasil->row();
        $update_data = array(
            "due_payment" => $jama_wasil_row->revenue + $jama_wasil_row->local_tax + $jama_wasil_row->opening_balance,
            "pay_status"  => 'UNPAID',
        ); 
        $this->db->where('dist_code', $dist_code);
        $this->db->where('subdiv_code', $subdiv_code);
        $this->db->where('cir_code', $cir_code);
        $this->db->where('mouza_pargona_code', $mouza_pargona_code);
        $this->db->where('lot_no', $lot_no);
        $this->db->where('vill_townprt_code', $vill_townprt_code);
        $this->db->where('patta_type_code', $patta_type_code);
        $this->db->where('patta_no', $patta_no);
        $this->db->update('jama_wasil', $update_data);
        if($this->db->affected_rows() != 1){ 
            $this->db->trans_rollback();
            log_message("error", "#ERR19072024003, Error in update, table 'jama_wasil'  with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #ERR19072024003'];
        }else{
            return ['result' => 'SUCCESS', 'msg' => 'Case Updated Successfully'];
        }
    }

    public function fetchArrearByMouzadar($dist_code,$subdiv_code,$cir_code, $mouza_pargona_code, $lot_no, $vill_townprt_code, $patta_type_code, $patta_no)
    {
        $query = $this->db->query("select * from ekhajana_arrear_pre_updation where dist_code=? and subdiv_code=? and cir_code=? and mouza_pargona_code=? and lot_no=? and vill_townprt_code=? and patta_type_code=? and patta_no=?",array($dist_code,$subdiv_code,$cir_code, $mouza_pargona_code, $lot_no, $vill_townprt_code, $patta_type_code, $patta_no));
       
        if($query->num_rows() ==0){
            return "NO-DATA-FOUND";
        }elseif($query->num_rows() > 1){
            return "NO-DATA-FOUND";
        }else{
            $arrear = $query->row();
            return $arrear;
        }

    }

