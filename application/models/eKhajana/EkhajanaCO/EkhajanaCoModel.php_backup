    //getting jama wasil details 
    public function getJamaWasilDetailsForDpEstate($dist_code,$subdiv_code,$cir_code, $mouza_pargona_code, $lot_no, $vill_townprt_code, $patta_type_code, $patta_no){
        $query = $this->db->select('*')
                          ->where('dist_code', $dist_code)
                          ->where('subdiv_code', $subdiv_code)
                          ->where('cir_code', $cir_code)
                          ->where('mouza_pargona_code', $mouza_pargona_code)
                          ->where('lot_no', $lot_no)
                          ->where('vill_townprt_code', $vill_townprt_code)
                          ->where('patta_type_code', $patta_type_code)
                          ->where('patta_no', $patta_no)
                          ->from('jama_wasil')
                          ->get();

        if($query->num_rows() == 1){
            $jama_wasil_details = $query->row();
            if($jama_wasil_details->status == JAMA_WASIL_STATUS_ONLINE){
                return "KHAJANA FOR PATTA ".$patta_no." IS PAID, YOU CAN FORWARD THIS CASE TO ADC TO DISPOSE. AFTER DISPOSED, THE PATTADAR CAN DOWNLOAD THE KHAJANA RECEIPT";
            }else{
                return "KHAJANA FOR PATTA ".$patta_no." IS UPDATED, BUT PAYMENT IS NOT RECIEVED FOR THIS PATTA";
            }
        }else{
            return "KHAJANA FOR PATTA ".$patta_no." IS NOT UPDATED YET";
        }
    }

    //function to forward the case to adc from co
    public function forwardToAdcDpEstate($posted_data)
    {
        $this->db->trans_begin();
        //updating ekhajana basic table status
        $update_data = array(
            'pending_with_officer' => 'ADC',
            'status' => EKHAJANA_STATUS_CO_FORWARD_DP_ESTATE,
            'co_remark' => $posted_data['co_report'],
            'modified_at' => date('Y-m-d h:i:s'),
        ); 
        $this->db->where('case_no', $posted_data['case_no']);
        $this->db->update('ekhajana_basic', $update_data);
        if($this->db->affected_rows() != 1){ 
            $this->db->trans_rollback();
            log_message("error", "#EKFTADC001, Error in update, table 'ekhajana_basic'  with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADC001'];
        }
        //ekhajana basic proceeding details insert
        $proceeding_details_data = array(
            'ld_application_no' => $posted_data['ld_application_no'],
            'application_no' => $posted_data['application_no'],
            'remark' => $posted_data['co_report'],            
            'user_code' => $this->session->all_userdata()['user_code'],
            "created_at" => date('Y-m-d h:i:s'),
            "case_no" => $posted_data['case_no'],
            'status' => EKHAJANA_STATUS_CO_FORWARD_DP_ESTATE
        ); 
        $tstatus2 = $this->db->insert('ekhajana_basic_proceedings', $proceeding_details_data); 
        if ($tstatus2!= 1)
        {
            $this->db->trans_rollback();
            log_message("error", "#EKFTADC002, Error in insert on ekhajana_basic_proceedings table with query- ". json_encode($this->db->last_query()));
            return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADC002'];
        }
        //*********************************************************/
        //checking row in chitha pattadar whether aadhar linked or not 
        $query = $this->db->select('*')
                    ->where('dist_code', $posted_data['dist_code'])
                    ->where('subdiv_code', $posted_data['subdiv_code'])
                    ->where('cir_code', $posted_data['cir_code'])
                    ->where('mouza_pargona_code', $posted_data['mouza_pargona_code'])
                    ->where('lot_no', $posted_data['lot_no'])
                    ->where('vill_townprt_code', $posted_data['vill_townprt_code'])
                    ->where('patta_no', $posted_data['patta_no'])
                    ->where('patta_type_code', $posted_data['patta_type_code'])
                    ->where('pdar_id', $posted_data['pdar_id'])   
                    ->from('chitha_pattadar')                 
                    ->get();
                  
        if($query!="" && $query!=null && $query->num_rows()==1){
            if($posted_data['aadhaar_pan_type'] == 'AADHAAR'){
                $update_data = array(
                    'pdar_aadharno' => $posted_data['aadhaar_pan_ref_no'],
                ); 
            }else if($posted_data['aadhaar_pan_type'] == 'PAN'){
                $update_data = array(
                    'pdar_pan_no' => $posted_data['aadhaar_pan_ref_no'],
                ); 
            }
            $this->db->where('dist_code', $posted_data['dist_code'])
                    ->where('subdiv_code', $posted_data['subdiv_code'])
                    ->where('cir_code', $posted_data['cir_code'])
                    ->where('mouza_pargona_code', $posted_data['mouza_pargona_code'])
                    ->where('lot_no', $posted_data['lot_no'])
                    ->where('vill_townprt_code', $posted_data['vill_townprt_code'])
                    ->where('patta_no', $posted_data['patta_no'])
                    ->where('patta_type_code', $posted_data['patta_type_code'])
                    ->where('pdar_id', $posted_data['pdar_id'])   
                    ->update('chitha_pattadar', $update_data);
                    
            if($this->db->affected_rows() != 1){ 
                $this->db->trans_rollback();
                log_message("error", "#EKFTADC003, Error in update, table 'chitha_pattadar'  with query- ". json_encode($this->db->last_query()));
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADC003'];
            }
        } 
        //*********************************************************/
        //final transaction status check 
        if($this->db->trans_status()==FALSE){
            $this->db->trans_rollback();
            log_message("error", "#EKFTADC004, Transaction Status Error In Saving data in dharitree with query- ". json_encode($this->db->last_query()));
            return ['result' => false, 'msg' => 'Some error occured, Error-Code : #EKFTADC004'];
        }else{
            $curl = curl_init();
            curl_setopt_array($curl, array(
                CURLOPT_URL => EKHAJANA_CO_FORWARD_FOR_DP_EASTAE_API,
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_ENCODING => '',
                CURLOPT_MAXREDIRS => 10,
                CURLOPT_TIMEOUT => 0,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                CURLOPT_CUSTOMREQUEST => 'POST',
                CURLOPT_SSL_VERIFYPEER => FALSE,
                CURLOPT_SSL_VERIFYHOST => 0,
                CURLOPT_POSTFIELDS => array(
                    'ld_application_no' => $posted_data['ld_application_no'],
                    'application_no' => $posted_data['application_no'],
                    'dharitree_case_no' => $posted_data['case_no'],
                    'user_code' => $this->session->all_userdata()['user_code'],                    
                    'date_of_action' => date("Y-m-d"),
                    "patta_no" => $posted_data['patta_no'],
                    'remark' => $posted_data['co_report'],
                ),
            ));
            $response = curl_exec($curl);
            $httpcode = curl_getinfo($curl, CURLINFO_HTTP_CODE);
            curl_close($curl);
            if($httpcode == 200){
                $response_obj = json_decode($response);
                if($response_obj->result == "Y"){
                    $this->db->trans_commit();
                    return ['result' => 'SUCCESS', 'msg' => 'Ekhajana Case Details Forwared To ADC Successfully!'];                 
                }else{
                    $this->db->trans_rollback();
                    log_message("error", "#EKFTADCCRLL004, Curl Error(Y) In Api ".EKHAJANA_CO_FORWARD_FOR_DP_EASTAE_API);
                    return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADCCRLL004'];
                } 
            }else{
                $this->db->trans_rollback();
                log_message("error", "#EKFTADCCRLL005, Curl Error(200) In Api ".EKHAJANA_CO_FORWARD_FOR_DP_EASTAE_API);
                return ['result' => 'SERVER-ERROR', 'msg' => 'Some error occured, Error-Code : #EKFTADCCRLL005'];
            }
        }
    }

